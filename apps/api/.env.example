# Copy to .env (gitignored) and fill with local values. Never commit real secrets.
# Supabase-compatible HS256 secret. Required for token verification; 32+ bytes recommended.
CONTENT_SUITE_AUTH_JWT_SECRET=
# Expected Supabase JWT issuer (https://<project-ref>.supabase.co/auth/v1) and audience.
# Both are enforced; auth returns 503 until the issuer is configured.
CONTENT_SUITE_AUTH_JWT_ISSUER=
# CONTENT_SUITE_AUTH_JWT_AUDIENCE=authenticated
# Browser origins allowed to call the API. Plain comma-separated list, e.g.
# https://content-suite.vercel.app,http://localhost:5173. "*" allows any origin
# (safe: auth is a bearer header, not cookies). Defaults to the local Vite dev server.
# CONTENT_SUITE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Emails allowed to self-serve create a workspace (POST /brands), matched
# case-insensitively. Plain comma-separated list, e.g. a@x.com,b@x.com. Empty
# (default) means nobody may -- required even after disabling Supabase public
# signups, since POST /brands has no other gate. Set to "*" to disable the
# check (local dev convenience only).
# CONTENT_SUITE_BRAND_CREATION_ALLOWLIST=
# Canonical target is Supabase PostgreSQL via psycopg, e.g. postgresql+psycopg://user:pass@host:5432/db
# Defaults to sqlite:///./content_suite_dev.db when unset.
# CONTENT_SUITE_DATABASE_URL=

# AI platform. Empty defaults: the app starts unconfigured; capabilities fail with
# AIProviderNotConfiguredError until a provider adapter exists.
# CONTENT_SUITE_AI_PROVIDER=
# OpenAI embeddings (production provider; env-gated, isolated in app/ai/providers).
# Adapter resolves only with AI_PROVIDER=openai + API key + a knowable dimension:
# an explicit positive setting or a model with documented defaults
# (text-embedding-3-small -> 1536, text-embedding-3-large -> 3072,
# text-embedding-ada-002 -> 1536 fixed). text-embedding-3-* also accepts an
# explicitly configured reduced dimension (e.g. 512) via the provider
# `dimensions` parameter; ada-002 rejects anything but its documented one.
# CONTENT_SUITE_OPENAI_API_KEY=
# CONTENT_SUITE_OPENAI_EMBEDDING_MODEL=
# CONTENT_SUITE_OPENAI_EMBEDDING_DIMENSIONS=0
# Chat/completions model for text generation. Empty defaults to gpt-4o-mini.
# CONTENT_SUITE_OPENAI_TEXT_MODEL=
# Vision provider for visual compliance audits (change 008). Independent of
# CONTENT_SUITE_AI_PROVIDER above: text/embeddings stay on OpenAI, Vision has
# no OpenAI adapter here, only GLM (Zhipu/Z.ai). Both PROVIDER and API_KEY
# must be set to enable the adapter; otherwise audits fail with a controlled
# 503 (no fallback). BASE_URL/MODEL default to Z.ai's Coding Plan endpoint
# and glm-5.3-flash when unset.
# CONTENT_SUITE_VISION_PROVIDER=glm
# CONTENT_SUITE_GLM_API_KEY=
# CONTENT_SUITE_GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# CONTENT_SUITE_GLM_VISION_MODEL=glm-5.3-flash
# Langfuse tracing. All three must be set to enable the adapter; otherwise tracing is no-op.
# CONTENT_SUITE_LANGFUSE_PUBLIC_KEY=
# CONTENT_SUITE_LANGFUSE_SECRET_KEY=
# CONTENT_SUITE_LANGFUSE_HOST=

# Private storage (change 008-visual-compliance). All three of URL/service key/bucket
# must be set to enable the Supabase Storage adapter; otherwise upload/signed-url
# operations fail with a controlled 503 (no fallback, no fake credentials).
# CONTENT_SUITE_STORAGE_PROJECT_URL=
# CONTENT_SUITE_STORAGE_SERVICE_KEY=
# CONTENT_SUITE_STORAGE_BUCKET=
# Signed URL TTL in seconds (short-lived by design).
# CONTENT_SUITE_STORAGE_SIGNED_URL_TTL_SECONDS=300
# Max upload size in bytes (rejects larger files with 422 before any storage call).
# CONTENT_SUITE_STORAGE_MAX_UPLOAD_BYTES=5242880
