# Copy to .env (gitignored) and fill with local values. Never commit real secrets.
# Supabase-compatible HS256 secret. Required for token verification; 32+ bytes recommended.
CONTENT_SUITE_AUTH_JWT_SECRET=
# Expected Supabase JWT issuer (https://<project-ref>.supabase.co/auth/v1) and audience.
# Both are enforced; auth returns 503 until the issuer is configured.
CONTENT_SUITE_AUTH_JWT_ISSUER=
# CONTENT_SUITE_AUTH_JWT_AUDIENCE=authenticated
# Canonical target is Supabase PostgreSQL via psycopg, e.g. postgresql+psycopg://user:pass@host:5432/db
# Defaults to sqlite:///./content_suite_dev.db when unset.
# CONTENT_SUITE_DATABASE_URL=

# AI platform. Empty defaults: the app starts unconfigured; capabilities fail with
# AIProviderNotConfiguredError until a provider adapter exists.
# CONTENT_SUITE_AI_PROVIDER=
# OpenAI embeddings (production provider; env-gated, isolated in app/ai/providers).
# Adapter resolves only with AI_PROVIDER=openai + API key + a knowable dimension:
# an explicit positive setting or a model with documented defaults
# (text-embedding-3-small -> 1536, text-embedding-3-large -> 3072,
# text-embedding-ada-002 -> 1536 fixed). text-embedding-3-* also accepts an
# explicitly configured reduced dimension (e.g. 512) via the provider
# `dimensions` parameter; ada-002 rejects anything but its documented one.
# CONTENT_SUITE_OPENAI_API_KEY=
# CONTENT_SUITE_OPENAI_EMBEDDING_MODEL=
# CONTENT_SUITE_OPENAI_EMBEDDING_DIMENSIONS=0
# Chat/completions model for text generation. Empty defaults to gpt-4o-mini.
# CONTENT_SUITE_OPENAI_TEXT_MODEL=
# Langfuse tracing. All three must be set to enable the adapter; otherwise tracing is no-op.
# CONTENT_SUITE_LANGFUSE_PUBLIC_KEY=
# CONTENT_SUITE_LANGFUSE_SECRET_KEY=
# CONTENT_SUITE_LANGFUSE_HOST=
