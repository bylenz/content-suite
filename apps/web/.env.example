# Base URL de la API FastAPI (apps/api). Por defecto: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Proyecto Supabase (Project Settings -> API). Requerido para el login por
# magic link; sin estas variables el formulario de login falla al montar.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
